#!/usr/bin/env bash
#
# dwc — dnsmasq-web control : outil de gestion unique.
#
# Usage (depuis le dossier du dépôt, ex. /var/www/dnsmasq-web) :
#     sudo bash dwc <commande> [options]
#
# Commandes :
#     install         Met en place toute la plomberie système (groupe, sudoers,
#                     dossier .conf, loader dnsmasq, base MySQL, config runtime).
#     uninstall       Retire tout ce qu'install a créé. --purge pour aussi
#                     supprimer la base de données.
#     create-admin    Crée ou met à jour un compte administrateur.
#     apply           Régénère les .conf depuis MySQL et recharge dnsmasq.
#     status          Diagnostic de santé de l'installation.
#     backup [dir]    Archive base + .conf + config dans un .tar.gz.
#     restore <file>  Restaure depuis une archive puis réapplique.
#     help            Affiche cette aide.
#
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURATION  (ajuste ici si besoin)
# ─────────────────────────────────────────────────────────────────────────────
WEB_USER="www-data"
DNSWEB_GROUP="dnsweb"
WEBUI_DIR="/etc/dnsmasq.d/webui"
DNSMASQ_CONFD="/etc/dnsmasq.d"
LEASES_FILE="/var/lib/misc/dnsmasq.leases"
APPLY_CMD="/usr/local/sbin/dnsweb-apply"
SUDOERS_FILE="/etc/sudoers.d/dnsweb"
LOADER="${DNSMASQ_CONFD}/00-dnsweb-loader.conf"
APP_CONF_DIR="/etc/dnsmasq-web"
APP_CONF_FILE="${APP_CONF_DIR}/config.php"
BACKUP_DIR_DEFAULT="/var/backups/dnsmasq-web"

DB_NAME="dnsmasq_web"
DB_USER="dnsweb"
DB_HOST="127.0.0.1"
DB_PASS=""                                # vide => généré à l'install

SETUP_PACKAGES=1
SETUP_DATABASE=1
SETUP_NGINX=0                             # 1 = créer un vhost nginx (sinon tu le fais)
NGINX_SERVER_NAME="dnsmasq.local"

# Racine du code, déduite de l'emplacement de ce script → portable.
SELF="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SELF")"
APP_DIR="${DWC_APP_DIR:-$SCRIPT_DIR/app}"

# ─────────────────────────────────────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────────────────────────────────────
c_info()  { printf '\033[1;34m[i]\033[0m %s\n' "$*"; }
c_ok()    { printf '\033[1;32m[✓]\033[0m %s\n' "$*"; }
c_warn()  { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
c_err()   { printf '\033[1;31m[✗]\033[0m %s\n' "$*" >&2; }
die()     { c_err "$*"; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "Cette commande doit être lancée en root (sudo bash dwc $1)."; }
confirm() { local r; read -rp "$1 [oui/N] " r; [ "$r" = "oui" ] || [ "$r" = "o" ]; }

# Lit une valeur de config.php via PHP (fiable). $1 = clé db (host|name|user|pass).
read_db() {
    php -r '$c=require $argv[1]; echo $c["db"][$argv[2]] ?? "";' "$APP_CONF_FILE" "$1"
}

# Client mysql avec les creds de l'app.
app_mysql() {
    local pass; pass="$(read_db pass)"
    MYSQL_PWD="$pass" mysql -h "$(read_db host)" -u "$(read_db user)" "$@"
}

# ═════════════════════════════════════════════════════════════════════════════
# install
# ═════════════════════════════════════════════════════════════════════════════
db_schema() {
cat <<'SQL'
CREATE TABLE IF NOT EXISTS users (
  id INT AUTO_INCREMENT PRIMARY KEY,
  username VARCHAR(64) NOT NULL UNIQUE,
  password_hash VARCHAR(255) NOT NULL,
  role ENUM('admin','viewer') NOT NULL DEFAULT 'admin',
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS dns_hosts (
  id INT AUTO_INCREMENT PRIMARY KEY, hostname VARCHAR(255) NOT NULL, ip VARCHAR(45) NOT NULL,
  enabled TINYINT(1) NOT NULL DEFAULT 1, comment VARCHAR(255) DEFAULT NULL,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  UNIQUE KEY uq_host_ip (hostname, ip)
) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS dns_cnames (
  id INT AUTO_INCREMENT PRIMARY KEY, alias VARCHAR(255) NOT NULL UNIQUE, target VARCHAR(255) NOT NULL,
  enabled TINYINT(1) NOT NULL DEFAULT 1, comment VARCHAR(255) DEFAULT NULL,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS dhcp_reservations (
  id INT AUTO_INCREMENT PRIMARY KEY, mac VARCHAR(17) NOT NULL UNIQUE, ip VARCHAR(45) NOT NULL,
  hostname VARCHAR(255) DEFAULT NULL, enabled TINYINT(1) NOT NULL DEFAULT 1, comment VARCHAR(255) DEFAULT NULL,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS blocklist (
  id INT AUTO_INCREMENT PRIMARY KEY, domain VARCHAR(255) NOT NULL UNIQUE,
  mode ENUM('block','allow') NOT NULL DEFAULT 'block', enabled TINYINT(1) NOT NULL DEFAULT 1,
  comment VARCHAR(255) DEFAULT NULL, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS settings (
  name VARCHAR(64) PRIMARY KEY, value TEXT,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;
CREATE TABLE IF NOT EXISTS audit_log (
  id INT AUTO_INCREMENT PRIMARY KEY, username VARCHAR(64) DEFAULT NULL, action VARCHAR(64) NOT NULL,
  detail TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;
SQL
}

cmd_install() {
    command -v apt-get >/dev/null 2>&1 || die "apt-get introuvable : cible Debian/Ubuntu."

    # 1) Paquets
    if [ "$SETUP_PACKAGES" -eq 1 ]; then
        c_info "Vérification des paquets requis…"
        local NEEDED=(dnsmasq)
        command -v php >/dev/null 2>&1 || NEEDED+=(php-fpm php-mysql php-cli)
        if ! command -v mysql >/dev/null 2>&1 && ! command -v mariadb >/dev/null 2>&1; then
            NEEDED+=(mariadb-server)
        fi
        [ "$SETUP_NGINX" -eq 1 ] && NEEDED+=(nginx)
        local TO_INSTALL=()
        local pkg
        for pkg in "${NEEDED[@]}"; do
            dpkg -s "$pkg" >/dev/null 2>&1 || TO_INSTALL+=("$pkg")
        done
        if [ "${#TO_INSTALL[@]}" -gt 0 ]; then
            c_info "Installation : ${TO_INSTALL[*]}"
            export DEBIAN_FRONTEND=noninteractive
            apt-get update -qq
            apt-get install -y -qq "${TO_INSTALL[@]}"
        fi
        c_ok "Paquets OK."
    fi

    # 2) Groupe + www-data
    c_info "Groupe '${DNSWEB_GROUP}'…"
    getent group "$DNSWEB_GROUP" >/dev/null 2>&1 || groupadd "$DNSWEB_GROUP"
    if id -nG "$WEB_USER" | tr ' ' '\n' | grep -qx "$DNSWEB_GROUP"; then
        c_ok "${WEB_USER} déjà dans ${DNSWEB_GROUP}."
    else
        usermod -aG "$DNSWEB_GROUP" "$WEB_USER"
        c_ok "${WEB_USER} ajouté à ${DNSWEB_GROUP}."
    fi

    # 3) Dossier .conf (setgid, groupe)
    c_info "Dossier ${WEBUI_DIR}…"
    mkdir -p "$WEBUI_DIR"
    chown root:"$DNSWEB_GROUP" "$WEBUI_DIR"
    chmod 2775 "$WEBUI_DIR"
    local INIT="${WEBUI_DIR}/00-init.conf"
    if [ ! -f "$INIT" ]; then
        printf '# Géré par dnsmasq-web — régénéré depuis MySQL, ne pas éditer.\n' > "$INIT"
        chown "$WEB_USER":"$DNSWEB_GROUP" "$INIT"; chmod 664 "$INIT"
    fi
    c_ok "Dossier prêt."

    # 4) Loader dnsmasq
    c_info "Loader dnsmasq (${LOADER})…"
    printf '# Généré par dwc — charge les fichiers de l\x27interface web.\nconf-dir=%s/,*.conf\n' "$WEBUI_DIR" > "$LOADER"
    chown root:root "$LOADER"; chmod 644 "$LOADER"
    if [ -f /etc/dnsmasq.conf ]; then
        grep -Eq '^\s*conf-dir=.*dnsmasq\.d' /etc/dnsmasq.conf || \
            printf '\n# Ajouté par dwc\nconf-dir=%s/,*.conf\n' "$DNSMASQ_CONFD" >> /etc/dnsmasq.conf
    else
        printf '# Créé par dwc\nconf-dir=%s/,*.conf\n' "$DNSMASQ_CONFD" > /etc/dnsmasq.conf
    fi
    c_ok "dnsmasq chargera ${WEBUI_DIR}."

    # 5) Wrapper root
    c_info "Wrapper ${APPLY_CMD}…"
    cat > "$APPLY_CMD" <<'EOF'
#!/usr/bin/env bash
# dnsweb-apply — valide puis recharge dnsmasq. Appelé via sudo, sans argument.
set -euo pipefail
if [ "$#" -ne 0 ]; then echo "Aucun argument accepté." >&2; exit 2; fi
if ! /usr/sbin/dnsmasq --test 2>&1; then
  echo "Validation dnsmasq échouée : configuration NON appliquée." >&2; exit 1
fi
/bin/systemctl restart dnsmasq
echo "dnsmasq rechargé avec succès."
EOF
    chown root:root "$APPLY_CMD"; chmod 750 "$APPLY_CMD"
    c_ok "Wrapper installé."

    # 6) Sudoers ciblé
    c_info "Règle sudo (${SUDOERS_FILE})…"
    printf '%s ALL=(root) NOPASSWD: %s\n' "$WEB_USER" "$APPLY_CMD" > "$SUDOERS_FILE"
    chmod 440 "$SUDOERS_FILE"
    if ! visudo -cf "$SUDOERS_FILE" >/dev/null 2>&1; then
        rm -f "$SUDOERS_FILE"; die "sudoers invalide — retiré."
    fi
    c_ok "Règle sudo validée."

    # 7) Baux lisibles
    mkdir -p "$(dirname "$LEASES_FILE")"
    [ -f "$LEASES_FILE" ] || : > "$LEASES_FILE"
    chgrp "$DNSWEB_GROUP" "$LEASES_FILE" 2>/dev/null || true
    chmod 640 "$LEASES_FILE" 2>/dev/null || true
    c_ok "Baux lisibles par le groupe."

    # 8) Base MySQL (user pour localhost ET 127.0.0.1 → couvre socket + TCP)
    if [ "$SETUP_DATABASE" -eq 1 ]; then
        c_info "Base MySQL…"
        [ -n "$DB_PASS" ] || DB_PASS="$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)"
        mysql -e "SELECT 1" >/dev/null 2>&1 || die "Connexion MySQL root (socket) impossible."
        mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASS}';
CREATE USER IF NOT EXISTS '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASS}';
ALTER USER '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASS}';
ALTER USER '${DB_USER}'@'127.0.0.1' IDENTIFIED BY '${DB_PASS}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'localhost';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
        db_schema | mysql "$DB_NAME"
        c_ok "Base '${DB_NAME}' + schéma prêts."
    fi

    # 9) Config runtime de l'app
    c_info "Config de l'app (${APP_CONF_FILE})…"
    mkdir -p "$APP_CONF_DIR"
    cat > "$APP_CONF_FILE" <<EOF
<?php
// Généré par dwc — configuration runtime de dnsmasq-web.
return [
    'db' => [
        'host' => '${DB_HOST}',
        'name' => '${DB_NAME}',
        'user' => '${DB_USER}',
        'pass' => '${DB_PASS}',
    ],
    'webui_dir'   => '${WEBUI_DIR}',
    'leases_file' => '${LEASES_FILE}',
    'apply_cmd'   => 'sudo ${APPLY_CMD}',
];
EOF
    chown root:"$WEB_USER" "$APP_CONF_FILE"; chmod 640 "$APP_CONF_FILE"
    c_ok "Config écrite."

    # 10) Vhost nginx (optionnel)
    if [ "$SETUP_NGINX" -eq 1 ]; then
        local SOCK; SOCK="$(ls -1 /run/php/php*-fpm.sock 2>/dev/null | head -n1 || true)"
        if [ -z "$SOCK" ]; then
            c_warn "Socket php-fpm introuvable — vhost non créé."
        else
            local SITE="/etc/nginx/sites-available/dnsmasq-web"
            cat > "$SITE" <<EOF
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    root ${APP_DIR}/public;
    index index.php;
    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location ~ \.php\$ { include snippets/fastcgi-php.conf; fastcgi_pass unix:${SOCK}; }
    location ~ /\.(?!well-known) { deny all; }
}
EOF
            ln -sf "$SITE" /etc/nginx/sites-enabled/dnsmasq-web
            nginx -t >/dev/null 2>&1 && systemctl reload nginx && c_ok "Vhost nginx activé." \
                || c_warn "nginx -t a échoué — vérifie la conf."
        fi
    fi

    # 11) Recharger services
    c_info "Rechargement des services…"
    local svc
    for svc in $(systemctl list-units --type=service --no-legend 'php*-fpm.service' 2>/dev/null | awk '{print $1}'); do
        systemctl restart "$svc" 2>/dev/null || true
    done
    if dnsmasq --test >/dev/null 2>&1; then
        systemctl enable dnsmasq >/dev/null 2>&1 || true
        systemctl restart dnsmasq 2>/dev/null || c_warn "Redémarrage dnsmasq à vérifier."
        c_ok "dnsmasq validé et redémarré."
    else
        c_warn "'dnsmasq --test' a échoué — corrige avant de démarrer."
    fi

    echo
    c_ok "Installation terminée."
    echo "  Docroot nginx à configurer : ${APP_DIR}/public"
    echo "  Config de l'app            : ${APP_CONF_FILE}"
    [ "$SETUP_DATABASE" -eq 1 ] && echo "  Base : ${DB_NAME} / user ${DB_USER} / mot de passe : ${DB_PASS}"
    echo "  Étape suivante : sudo bash dwc create-admin admin"
}

# ═════════════════════════════════════════════════════════════════════════════
# uninstall
# ═════════════════════════════════════════════════════════════════════════════
cmd_uninstall() {
    local purge=0
    [ "${1:-}" = "--purge" ] && purge=1
    c_warn "Cette opération retire la plomberie système de dnsmasq-web."
    [ "$purge" -eq 1 ] && c_warn "--purge : la base '${DB_NAME}' sera SUPPRIMÉE."
    confirm "Continuer ?" || { c_info "Annulé."; return 0; }

    rm -f "$SUDOERS_FILE" && c_ok "sudoers retiré." || true
    rm -f "$APPLY_CMD"    && c_ok "wrapper retiré." || true
    rm -f "$LOADER"       && c_ok "loader dnsmasq retiré." || true
    if [ -d "$WEBUI_DIR" ]; then rm -rf "$WEBUI_DIR" && c_ok "dossier .conf retiré."; fi
    rm -f "$APP_CONF_FILE"; rmdir "$APP_CONF_DIR" 2>/dev/null || true
    c_ok "config runtime retirée."

    # Retirer www-data du groupe puis supprimer le groupe (s'il est vide).
    if id -nG "$WEB_USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$DNSWEB_GROUP"; then
        gpasswd -d "$WEB_USER" "$DNSWEB_GROUP" >/dev/null 2>&1 || true
    fi
    getent group "$DNSWEB_GROUP" >/dev/null 2>&1 && groupdel "$DNSWEB_GROUP" 2>/dev/null || true
    c_ok "groupe ${DNSWEB_GROUP} retiré."

    if [ "$purge" -eq 1 ]; then
        mysql <<SQL 2>/dev/null || c_warn "Suppression base : échec (fais-le manuellement)."
DROP DATABASE IF EXISTS \`${DB_NAME}\`;
DROP USER IF EXISTS '${DB_USER}'@'localhost';
DROP USER IF EXISTS '${DB_USER}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
        c_ok "base '${DB_NAME}' supprimée."
    else
        c_info "Base '${DB_NAME}' conservée (relance avec --purge pour la supprimer)."
    fi

    # Recharger services pour prendre en compte le retrait.
    local svc
    for svc in $(systemctl list-units --type=service --no-legend 'php*-fpm.service' 2>/dev/null | awk '{print $1}'); do
        systemctl restart "$svc" 2>/dev/null || true
    done
    systemctl restart dnsmasq 2>/dev/null || true
    c_ok "Désinstallation terminée. (Le code cloné et ton vhost nginx ne sont pas touchés.)"
}

# ═════════════════════════════════════════════════════════════════════════════
# create-admin
# ═════════════════════════════════════════════════════════════════════════════
cmd_create_admin() {
    [ -f "$APP_CONF_FILE" ] || die "Lance d'abord : sudo bash dwc install"
    [ -f "$APP_DIR/bin/create-admin.php" ] || die "Code introuvable dans $APP_DIR (dépôt cloné ?)."
    php "$APP_DIR/bin/create-admin.php" "$@"
}

# ═════════════════════════════════════════════════════════════════════════════
# apply
# ═════════════════════════════════════════════════════════════════════════════
cmd_apply() {
    [ -f "$APP_CONF_FILE" ] || die "Lance d'abord : sudo bash dwc install"
    c_info "Régénération des .conf depuis MySQL + rechargement…"
    php "$APP_DIR/bin/apply.php" && c_ok "Appliqué." || die "Échec de l'application."
}

# ═════════════════════════════════════════════════════════════════════════════
# status
# ═════════════════════════════════════════════════════════════════════════════
ok() { printf '  \033[1;32m✓\033[0m %-38s %s\n' "$1" "${2:-}"; }
ko() { printf '  \033[1;31m✗\033[0m %-38s %s\n' "$1" "${2:-}"; }
cmd_status() {
    echo "── État de dnsmasq-web ──"
    local a t n
    a="$(systemctl is-active dnsmasq 2>/dev/null || true)"
    [ "$a" = active ] && ok "Service dnsmasq" "$a" || ko "Service dnsmasq" "$a"
    systemctl list-units --type=service --no-legend 'php*-fpm.service' 2>/dev/null | grep -q running \
        && ok "php-fpm en cours" || ko "php-fpm en cours"
    id -nG "$WEB_USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$DNSWEB_GROUP" \
        && ok "${WEB_USER} dans ${DNSWEB_GROUP}" || ko "${WEB_USER} dans ${DNSWEB_GROUP}"
    { [ -d "$WEBUI_DIR" ] && [ -w "$WEBUI_DIR" ]; } \
        && ok "Dossier .conf inscriptible" "$WEBUI_DIR" || ko "Dossier .conf inscriptible" "$WEBUI_DIR"
    [ -x "$APPLY_CMD" ]  && ok "Wrapper présent" "$APPLY_CMD"   || ko "Wrapper présent" "$APPLY_CMD"
    [ -f "$SUDOERS_FILE" ] && ok "Règle sudo présente"         || ko "Règle sudo présente"
    [ -f "$LOADER" ]     && ok "Loader dnsmasq présent"         || ko "Loader dnsmasq présent"
    [ -f "$APP_CONF_FILE" ] && ok "Config de l'app présente"    || ko "Config de l'app présente"
    [ -r "$LEASES_FILE" ] && ok "Baux lisibles" "$LEASES_FILE"  || ko "Baux lisibles" "$LEASES_FILE"

    if [ -f "$APP_CONF_FILE" ]; then
        if app_mysql -e "SELECT 1" >/dev/null 2>&1; then
            ok "Connexion base" "$(read_db name)"
            for t in dns_hosts dns_cnames dhcp_reservations blocklist users; do
                n="$(app_mysql -N "$(read_db name)" -e "SELECT COUNT(*) FROM $t" 2>/dev/null || echo '?')"
                printf '      %-22s %s\n' "$t" "$n"
            done
        else
            ko "Connexion base" "échec d'authentification"
        fi
    fi
}

# ═════════════════════════════════════════════════════════════════════════════
# backup / restore
# ═════════════════════════════════════════════════════════════════════════════
cmd_backup() {
    [ -f "$APP_CONF_FILE" ] || die "Rien à sauvegarder (installe d'abord)."
    local dir="${1:-$BACKUP_DIR_DEFAULT}"; mkdir -p "$dir"
    local ts file tmp; ts="$(date +%Y%m%d-%H%M%S)"; file="$dir/dnsmasq-web-$ts.tar.gz"
    tmp="$(mktemp -d)"
    # --no-tablespaces : l'utilisateur de l'app n'a pas le privilège global PROCESS.
    MYSQL_PWD="$(read_db pass)" mysqldump -h "$(read_db host)" -u "$(read_db user)" \
        --single-transaction --no-tablespaces "$(read_db name)" > "$tmp/db.sql"
    cp -a "$WEBUI_DIR" "$tmp/webui" 2>/dev/null || mkdir -p "$tmp/webui"
    cp -a "$APP_CONF_FILE" "$tmp/config.php"
    tar czf "$file" -C "$tmp" .
    rm -rf "$tmp"
    chmod 600 "$file"
    c_ok "Sauvegarde : $file"
}
cmd_restore() {
    local file="${1:-}"
    [ -f "$file" ] || die "Usage : dwc restore <archive.tar.gz>"
    c_warn "La base '${DB_NAME}' et les .conf seront ÉCRASÉS par l'archive."
    confirm "Continuer ?" || { c_info "Annulé."; return 0; }
    local tmp; tmp="$(mktemp -d)"; tar xzf "$file" -C "$tmp"
    [ -f "$tmp/db.sql" ] || { rm -rf "$tmp"; die "Archive invalide (db.sql manquant)."; }
    app_mysql "$(read_db name)" < "$tmp/db.sql"
    if [ -d "$tmp/webui" ]; then
        mkdir -p "$WEBUI_DIR"
        cp -a "$tmp/webui/." "$WEBUI_DIR/"
        chown -R root:"$DNSWEB_GROUP" "$WEBUI_DIR"; chmod 2775 "$WEBUI_DIR"
    fi
    rm -rf "$tmp"
    c_ok "Données restaurées."
    cmd_apply
}

# ═════════════════════════════════════════════════════════════════════════════
# help + dispatch
# ═════════════════════════════════════════════════════════════════════════════
cmd_help() {
    awk 'NR>=3 { if ($0 !~ /^#/) exit; sub(/^# ?/,""); print }' "$SELF"
}

case "${1:-help}" in
    install)      shift; need_root install;      cmd_install "$@";;
    uninstall)    shift; need_root uninstall;    cmd_uninstall "$@";;
    create-admin) shift; need_root create-admin; cmd_create_admin "$@";;
    apply)        shift; need_root apply;         cmd_apply "$@";;
    status)       shift; need_root status;        cmd_status "$@";;
    backup)       shift; need_root backup;        cmd_backup "$@";;
    restore)      shift; need_root restore;       cmd_restore "$@";;
    help|-h|--help) cmd_help;;
    *) c_err "Commande inconnue : $1"; echo; cmd_help; exit 1;;
esac
